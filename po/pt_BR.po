#: src/pynextcloud_sync/application.py:183
msgid "Checking for Updates"
msgstr "Verificando atualização"

#: src/pynextcloud_sync/application.py:184
msgid "Contacting the GitHub version service…"
msgstr "Consultando o serviço de versões do GitHub…"

#: src/pynextcloud_sync/application.py:194
msgid "Could Not Check for Updates"
msgstr "Não foi possível verificar atualizações"

#: src/pynextcloud_sync/application.py:196
msgid ""
"The version information could not be obtained. Check your connection and try "
"again later."
msgstr ""
"Não foi possível obter as informações de versão. Verifique sua conexão e "
"tente novamente mais tarde."

#: src/pynextcloud_sync/application.py:209
msgid "PyNextCloud Sync Is Up to Date"
msgstr "O PyNextCloud Sync está atualizado"

#: src/pynextcloud_sync/application.py:210
msgid "You are already using the latest available version."
msgstr "Você já está usando a versão mais recente disponível."

#: src/pynextcloud_sync/application.py:226
msgid "Close"
msgstr "Fechar"

#: src/pynextcloud_sync/application.py:605
msgid "Nextcloud account needs attention"
msgstr "A conta do Nextcloud precisa de atenção"

#: src/pynextcloud_sync/application.py:606
msgid "Open PyNextCloud Sync to check the account credential."
msgstr "Abra o PyNextCloud Sync para verificar a credencial da conta."

#: src/pynextcloud_sync/application.py:610
msgid "Synchronization failed"
msgstr "Falha na sincronização"

#: src/pynextcloud_sync/application.py:613
#, python-brace-format
msgid ""
"Synchronization failed after {retries} retries. Open the log for details."
msgstr ""
"A sincronização falhou após {retries} tentativas. Abra o log para ver os "
"detalhes."

#: src/pynextcloud_sync/application.py:621
msgid "Synchronization paused for safety"
msgstr "Sincronização pausada por segurança"

#: src/pynextcloud_sync/application.py:626
#, python-brace-format
msgid ""
"Local files are missing ({count}). Review the change before they can be "
"deleted from Nextcloud."
msgstr ""
"Há arquivos locais ausentes ({count}). Revise a alteração antes de permitir "
"que sejam excluídos do Nextcloud."

#: src/pynextcloud_sync/application.py:632
msgid ""
"The local synchronization folder changed unexpectedly. Nothing was deleted "
"from Nextcloud."
msgstr ""
"A pasta local de sincronização mudou inesperadamente. Nada foi excluído do "
"Nextcloud."

#: src/pynextcloud_sync/application.py:635
msgid "Review Now"
msgstr "Revisar agora"

#: src/pynextcloud_sync/application.py:672
msgid "Synchronization blocked for safety"
msgstr "Sincronização bloqueada por segurança"

#: src/pynextcloud_sync/application.py:675
msgid "Keep Paused"
msgstr "Manter pausado"

#: src/pynextcloud_sync/application.py:676
msgid "Restore from Nextcloud"
msgstr "Restaurar a partir do Nextcloud"

#: src/pynextcloud_sync/application.py:679
msgid "Approve These Deletions Once"
msgstr "Aprovar estas exclusões uma vez"

#: src/pynextcloud_sync/application.py:715
msgid "Finishing synchronization"
msgstr "Finalizando a sincronização"

#: src/pynextcloud_sync/application.py:717
msgid "PyNextCloud Sync will quit when the current synchronization finishes."
msgstr ""
"O PyNextCloud Sync será encerrado quando a sincronização atual terminar."

#: src/pynextcloud_sync/core/runtime.py:199
#: src/pynextcloud_sync/core/scheduler.py:173
msgid "Synchronization scheduled"
msgstr "Sincronização agendada"

#: src/pynextcloud_sync/core/runtime.py:210
msgid ""
"Filesystem watch limit reached; using a local safety interval for this "
"session"
msgstr ""
"O limite de monitoramentos do sistema de arquivos foi atingido; usando um "
"intervalo local de segurança nesta sessão"

#: src/pynextcloud_sync/core/runtime.py:249
msgid "Unlock the password keyring to connect push notifications."
msgstr "Desbloqueie a carteira de senhas para conectar as notificações push."

#: src/pynextcloud_sync/core/runtime.py:287
msgid ""
"Automatic remote detection is unavailable; use Sync Now or enable the remote "
"safety interval."
msgstr ""
"A detecção remota automática está indisponível; use Sincronizar agora ou "
"ative o intervalo remoto de segurança."

#: src/pynextcloud_sync/core/scheduler.py:90
#: src/pynextcloud_sync/core/scheduler.py:108
#: src/pynextcloud_sync/core/scheduler.py:467
msgid "Reconnect the Nextcloud account to resume synchronization"
msgstr "Reconecte a conta do Nextcloud para retomar a sincronização"

#: src/pynextcloud_sync/core/scheduler.py:98
#: src/pynextcloud_sync/core/scheduler.py:463
msgid "Safety review required"
msgstr "Revisão de segurança necessária"

#: src/pynextcloud_sync/core/scheduler.py:130
#: src/pynextcloud_sync/core/scheduler.py:454
#: src/pynextcloud_sync/core/scheduler.py:474
msgid "Waiting for a network connection"
msgstr "Aguardando conexão com a rede"

#: src/pynextcloud_sync/core/scheduler.py:135
#: src/pynextcloud_sync/core/scheduler.py:265
msgid "Password keyring is locked"
msgstr "A carteira de senhas está bloqueada"

#: src/pynextcloud_sync/core/scheduler.py:154
msgid "Waiting for local changes to settle"
msgstr "Aguardando a conclusão das alterações locais"

#: src/pynextcloud_sync/core/scheduler.py:198
msgid "Checking the safety baseline…"
msgstr "Verificando a base de segurança…"

#: src/pynextcloud_sync/core/scheduler.py:255
msgid "Synchronizing files…"
msgstr "Sincronizando arquivos…"

#: src/pynextcloud_sync/core/scheduler.py:268
msgid "Could not read the account credential"
msgstr "Não foi possível ler a credencial da conta"

#: src/pynextcloud_sync/core/scheduler.py:274
msgid "No stored credential was found"
msgstr "Nenhuma credencial armazenada foi encontrada"

#: src/pynextcloud_sync/core/scheduler.py:304
#: src/pynextcloud_sync/core/scheduler.py:358
msgid "Synchronization failed — view the log"
msgstr "Falha na sincronização — veja o log"

#: src/pynextcloud_sync/core/scheduler.py:334
msgid "Synchronized with conflicts — review the log"
msgstr "Sincronizado com conflitos — verifique o log"

#: src/pynextcloud_sync/core/scheduler.py:427
#: src/pynextcloud_sync/core/scheduler.py:470
msgid "Synchronization is paused"
msgstr "A sincronização está pausada"

#: src/pynextcloud_sync/core/scheduler.py:440
msgid "Will pause after the current synchronization"
msgstr "Será pausada após a sincronização atual"

#: src/pynextcloud_sync/core/scheduler.py:440
#: src/pynextcloud_sync/core/scheduler.py:472
msgid "Paused on battery"
msgstr "Pausado durante o uso da bateria"

#: src/pynextcloud_sync/core/scheduler.py:476
msgid "Automatic synchronization is off"
msgstr "A sincronização automática está desativada"

#: src/pynextcloud_sync/core/scheduler.py:478
#: src/pynextcloud_sync/ui/main_window.py:27
msgid "Synchronized"
msgstr "Sincronizado"

#: src/pynextcloud_sync/core/bootstrap.py:252
msgid "Creating an isolated safety snapshot…"
msgstr "Criando uma cópia de segurança isolada…"

#: src/pynextcloud_sync/core/bootstrap.py:259
msgid "The protected staging folder was not empty."
msgstr "A pasta temporária protegida não estava vazia."

#: src/pynextcloud_sync/core/bootstrap.py:261
msgid "Downloading a protected copy from Nextcloud…"
msgstr "Baixando uma cópia protegida do Nextcloud…"

#: src/pynextcloud_sync/core/bootstrap.py:265
msgid "Comparing paths, sizes, dates, and file contents…"
msgstr "Comparando caminhos, tamanhos, datas e conteúdos dos arquivos…"

#: src/pynextcloud_sync/core/bootstrap.py:328
msgid ""
"The protected initialization cannot continue while unreadable or unsupported "
"paths exist."
msgstr ""
"A inicialização protegida não pode continuar enquanto existirem caminhos "
"ilegíveis ou sem suporte."

#: src/pynextcloud_sync/core/bootstrap.py:334
msgid ""
"The local folder changed after the analysis. Run the safety analysis again "
"before applying anything."
msgstr ""
"A pasta local mudou após a análise. Execute a análise de segurança novamente "
"antes de aplicar qualquer alteração."

#: src/pynextcloud_sync/core/bootstrap.py:336
msgid "Preparing the selected merge without discarding either version…"
msgstr "Preparando a mesclagem escolhida sem descartar nenhuma versão…"

#: src/pynextcloud_sync/core/bootstrap.py:339
msgid "Applying the reviewed result to Nextcloud…"
msgstr "Aplicando ao Nextcloud o resultado revisado…"

#: src/pynextcloud_sync/core/bootstrap.py:343
msgid "Archiving old synchronization state and updating the local folder…"
msgstr ""
"Arquivando o estado de sincronização antigo e atualizando a pasta local…"

#: src/pynextcloud_sync/core/bootstrap.py:347
msgid "Creating a clean synchronization baseline…"
msgstr "Criando uma base de sincronização limpa…"

#: src/pynextcloud_sync/core/bootstrap.py:355
msgid "The final local verification could not read every path."
msgstr "A verificação local final não conseguiu ler todos os caminhos."

#: src/pynextcloud_sync/core/bootstrap.py:361
msgid ""
"The final verification found differences; automatic synchronization remains "
"blocked."
msgstr ""
"A verificação final encontrou diferenças; a sincronização automática "
"continua bloqueada."

#: src/pynextcloud_sync/core/bootstrap.py:417
#: src/pynextcloud_sync/core/bootstrap.py:564
msgid "Protected initialization was cancelled."
msgstr "A inicialização protegida foi cancelada."

#: src/pynextcloud_sync/core/safety.py:262
msgid "The safety baseline is missing. Review both sides before synchronizing."
msgstr ""
"A base de segurança está ausente. Revise os dois lados antes de sincronizar."

#: src/pynextcloud_sync/core/safety.py:267
msgid ""
"The synchronized account or local folder changed since the last safe "
"baseline."
msgstr ""
"A conta sincronizada ou a pasta local mudou desde a última base segura."

#: src/pynextcloud_sync/core/safety.py:274
msgid "The local synchronization folder is missing or unavailable."
msgstr "A pasta local de sincronização está ausente ou indisponível."

#: src/pynextcloud_sync/core/safety.py:281
#, python-brace-format
msgid "The local folder cannot be read: {error}"
msgstr "A pasta local não pode ser lida: {error}"

#: src/pynextcloud_sync/core/safety.py:287
msgid ""
"The local synchronization folder appears to have been replaced or remounted."
msgstr ""
"A pasta local de sincronização parece ter sido substituída ou remontada."

#: src/pynextcloud_sync/core/safety.py:295
msgid ""
"The local synchronization folder identity changed since the last safe "
"baseline."
msgstr ""
"A identidade da pasta local de sincronização mudou desde a última base "
"segura."

#: src/pynextcloud_sync/core/safety.py:302
msgid ""
"Some local paths could not be read. Synchronization is blocked to avoid "
"treating them as deleted."
msgstr ""
"Alguns caminhos locais não puderam ser lidos. A sincronização foi bloqueada "
"para evitar tratá-los como excluídos."

#: src/pynextcloud_sync/core/safety.py:313
msgid "A previously populated synchronization folder is now empty."
msgstr ""
"Uma pasta de sincronização que antes continha arquivos agora está vazia."

#: src/pynextcloud_sync/core/safety.py:323
msgid "The Nextcloud synchronization state database disappeared unexpectedly."
msgstr ""
"O banco de estado da sincronização do Nextcloud desapareceu inesperadamente."

#: src/pynextcloud_sync/core/safety.py:337
msgid ""
"An unusual number of local files disappeared and could be deleted from "
"Nextcloud."
msgstr ""
"Uma quantidade incomum de arquivos locais desapareceu e poderia ser excluída "
"do Nextcloud."

#: src/pynextcloud_sync/nextcloud/push.py:60
msgid "Push notifications are disabled."
msgstr "As notificações push estão desativadas."

#: src/pynextcloud_sync/nextcloud/push.py:77
msgid "Discovering server push support…"
msgstr "Verificando o suporte a push do servidor…"

#: src/pynextcloud_sync/nextcloud/push.py:92
#: src/pynextcloud_sync/nextcloud/push.py:198
msgid "Push authentication failed."
msgstr "Falha na autenticação do push."

#: src/pynextcloud_sync/nextcloud/push.py:100
msgid "This server does not offer notify_push."
msgstr "Este servidor não oferece notify_push."

#: src/pynextcloud_sync/nextcloud/push.py:192
msgid "Connected"
msgstr "Conectado"

#: src/pynextcloud_sync/nextcloud/push.py:234
#, python-brace-format
msgid "Reconnecting in {seconds} seconds"
msgstr "Reconectando em {seconds} segundos"

#: src/pynextcloud_sync/nextcloud/push.py:266
msgid "Disconnected"
msgstr "Desconectado"

#: src/pynextcloud_sync/ui/log_view.py:17
msgid "Synchronization Log"
msgstr "Log de sincronização"

#: src/pynextcloud_sync/ui/log_view.py:46
msgid "Auto-scroll"
msgstr "Rolagem automática"

#: src/pynextcloud_sync/ui/log_view.py:49
msgid "Copy"
msgstr "Copiar"

#: src/pynextcloud_sync/ui/log_view.py:52
msgid "Open Log Folder"
msgstr "Abrir pasta de logs"

#: src/pynextcloud_sync/ui/about.py:36
msgid "A lightweight Nextcloud synchronization client for Linux."
msgstr "Um cliente leve de sincronização do Nextcloud para Linux."

#: src/pynextcloud_sync/ui/about.py:46
msgid "Source code on GitHub"
msgstr "Código-fonte no GitHub"

#: src/pynextcloud_sync/ui/about.py:48
msgid "Check for Updates"
msgstr "Verificar atualização"

#: src/pynextcloud_sync/ui/about.py:58
msgid "Report a problem"
msgstr "Relatar um problema"

#: src/pynextcloud_sync/ui/about.py:59
msgid "Complete changelog"
msgstr "Histórico completo de alterações"

#: src/pynextcloud_sync/ui/about.py:60 src/pynextcloud_sync/ui/about.py:72
msgid "Terms of Use"
msgstr "Termos de uso"

#: src/pynextcloud_sync/ui/about.py:61
msgid "Third-party projects and licenses"
msgstr "Projetos de terceiros e licenças"

#: src/pynextcloud_sync/ui/about.py:63
msgid "Synchronization Engine"
msgstr "Mecanismo de sincronização"

#: src/pynextcloud_sync/ui/about.py:66
msgid "Desktop Technologies"
msgstr "Tecnologias do desktop"

#: src/pynextcloud_sync/ui/about.py:69
msgid "Languages"
msgstr "Idiomas"

#: src/pynextcloud_sync/ui/about_content.py:10
msgid ""
"PyNextCloud Sync is an independent, unofficial third-party project. It is "
"not affiliated with, sponsored by, endorsed by, maintained by, or otherwise "
"connected to Nextcloud GmbH. Nextcloud is a registered trademark of "
"Nextcloud GmbH.\n"
"\n"
"Bidirectional synchronization can upload, download, replace, conflict, or "
"delete files on both the computer and the configured server. Use this "
"software entirely at your own risk, test it with non-critical data, and "
"maintain independent, restorable backups. The authors and contributors are "
"not responsible for lost, corrupted, deleted, or otherwise damaged data.\n"
"\n"
"The application delegates file reconciliation and conflict handling to "
"nextcloudcmd. Availability of notify_push and other server features depends "
"on the Nextcloud installation. This release was tested with Nextcloud Hub 26 "
"Spring (34.0.1) on Nextcloud AIO. Compatibility with other or future "
"Nextcloud versions is not guaranteed.\n"
"\n"
"No telemetry, advertising, or usage tracking is included. Credentials are "
"stored through the desktop Secret Service. Use of this software is also "
"subject to the GNU General Public License version 3 or later and its "
"warranty disclaimer."
msgstr ""
"O PyNextCloud Sync é um projeto independente, não oficial e desenvolvido por "
"terceiros. Não possui afiliação, patrocínio, endosso, manutenção ou qualquer "
"outro vínculo com a Nextcloud GmbH. Nextcloud é marca registrada da "
"Nextcloud GmbH.\n"
"\n"
"A sincronização bidirecional pode enviar, receber, substituir, gerar "
"conflitos ou excluir arquivos no computador e no servidor configurado. Use "
"este software integralmente por sua conta e risco, teste-o com dados não "
"críticos e mantenha backups independentes e restauráveis. Os autores e "
"colaboradores não se responsabilizam por dados perdidos, corrompidos, "
"excluídos ou danificados de qualquer outra forma.\n"
"\n"
"O aplicativo delega a reconciliação de arquivos e o tratamento de conflitos "
"ao nextcloudcmd. A disponibilidade do notify_push e de outros recursos do "
"servidor depende da instalação do Nextcloud. Esta versão foi testada com o "
"Nextcloud Hub 26 Spring (34.0.1) no Nextcloud AIO. Não há garantia de "
"compatibilidade com outras versões ou versões futuras do Nextcloud.\n"
"\n"
"Não há telemetria, publicidade ou rastreamento de uso. As credenciais são "
"armazenadas pelo Secret Service do ambiente gráfico. O uso deste software "
"também está sujeito à Licença Pública Geral GNU versão 3 ou posterior e à "
"respectiva isenção de garantias."

#: src/pynextcloud_sync/ui/about_content.py:34
msgid "Version 0.1.32"
msgstr "Versão 0.1.32"

#: src/pynextcloud_sync/ui/about_content.py:36
msgid ""
"Local mass-deletion safety alerts use urgent GNOME desktop notifications."
msgstr ""
"Os alertas de segurança para exclusões locais em massa usam notificações "
"urgentes do GNOME."

#: src/pynextcloud_sync/ui/about_content.py:37
msgid ""
"The notification opens the safety review directly through its Review Now "
"action."
msgstr ""
"A notificação abre diretamente a revisão de segurança pela ação Revisar "
"agora."

#: src/pynextcloud_sync/ui/about_content.py:38
msgid ""
"The alert explains that synchronization paused before local deletions could "
"reach Nextcloud."
msgstr ""
"O alerta explica que a sincronização foi pausada antes que as exclusões "
"locais chegassem ao Nextcloud."

#: src/pynextcloud_sync/ui/about_content.py:39
msgid "Resolved or obsolete safety notifications are removed automatically."
msgstr ""
"As notificações de segurança resolvidas ou obsoletas são removidas "
"automaticamente."

#: src/pynextcloud_sync/ui/about_content.py:43
msgid "Version 0.1.31"
msgstr "Versão 0.1.31"

#: src/pynextcloud_sync/ui/about_content.py:45
msgid ""
"Account, storage, and server details are persisted and shown immediately "
"when windows open."
msgstr ""
"Os detalhes da conta, do armazenamento e do servidor são persistidos e "
"exibidos imediatamente ao abrir as janelas."

#: src/pynextcloud_sync/ui/about_content.py:46
msgid ""
"Remote identity and server information refresh once when the application "
"process starts."
msgstr ""
"A identidade remota e as informações do servidor são atualizadas uma vez "
"quando o processo do aplicativo inicia."

#: src/pynextcloud_sync/ui/about_content.py:47
msgid "Only storage usage refreshes after each successful synchronization."
msgstr ""
"Somente o uso do armazenamento é atualizado após cada sincronização bem-"
"sucedida."

#: src/pynextcloud_sync/ui/about_content.py:48
msgid ""
"Opening Home or Settings no longer causes another authenticated quota "
"request."
msgstr ""
"Abrir a Home ou as Configurações não provoca outra consulta autenticada da "
"cota."

#: src/pynextcloud_sync/ui/about_content.py:49
msgid ""
"Account and server information can still be refreshed manually from Settings."
msgstr ""
"As informações da conta e do servidor ainda podem ser atualizadas "
"manualmente nas Configurações."

#: src/pynextcloud_sync/ui/about_content.py:53
msgid "Version 0.1.30"
msgstr "Versão 0.1.30"

#: src/pynextcloud_sync/ui/about_content.py:55
msgid "Defined quotas show their occupied percentage inside the progress bar."
msgstr ""
"Cotas definidas mostram a porcentagem ocupada dentro da barra de progresso."

#: src/pynextcloud_sync/ui/about_content.py:56
msgid ""
"Unlimited quotas use a static empty bar with a centered infinity symbol."
msgstr ""
"Cotas ilimitadas usam uma barra estática vazia com o símbolo de infinito "
"centralizado."

#: src/pynextcloud_sync/ui/about_content.py:57
msgid ""
"Loading and unavailable storage states no longer animate the progress bar."
msgstr ""
"Os estados de carregamento e armazenamento indisponível não animam mais a "
"barra de progresso."

#: src/pynextcloud_sync/ui/about_content.py:61
msgid "Version 0.1.29"
msgstr "Versão 0.1.29"

#: src/pynextcloud_sync/ui/about_content.py:63
msgid ""
"Temporary HTTP 429 validation limits preserve and retry the same new "
"authorization."
msgstr ""
"Limites temporários HTTP 429 durante a validação preservam e repetem a mesma "
"nova autorização."

#: src/pynextcloud_sync/ui/about_content.py:64
msgid ""
"Validated account details are reused after reconnection without an immediate "
"duplicate authenticated request."
msgstr ""
"Os dados validados da conta são reutilizados após a reconexão, sem repetir "
"imediatamente uma requisição autenticada."

#: src/pynextcloud_sync/ui/about_content.py:65
msgid ""
"Temporary account-information failures are no longer described as requiring "
"reconnection."
msgstr ""
"Falhas temporárias nas informações da conta não são mais descritas como "
"exigindo reconexão."

#: src/pynextcloud_sync/ui/about_content.py:66
msgid ""
"Storage usage is shown on the main window for bounded and unlimited quotas."
msgstr ""
"O uso do armazenamento é exibido na janela principal para cotas definidas e "
"ilimitadas."

#: src/pynextcloud_sync/ui/about_content.py:70
msgid "Version 0.1.28"
msgstr "Versão 0.1.28"

#: src/pynextcloud_sync/ui/about_content.py:72
msgid ""
"Replaced the oversized reconnect status page with a compact native header."
msgstr ""
"A página de status de reconexão superdimensionada foi substituída por um "
"cabeçalho nativo compacto."

#: src/pynextcloud_sync/ui/about_content.py:73
msgid ""
"Prevented reconnect titles, descriptions, and account rows from overlapping."
msgstr ""
"Títulos, descrições e linhas da conta não se sobrepõem mais na janela de "
"reconexão."

#: src/pynextcloud_sync/ui/about_content.py:74
msgid ""
"Kept account details and browser authorization visible without internal "
"scrolling."
msgstr ""
"Os dados da conta e a autorização pelo navegador permanecem visíveis sem "
"rolagem interna."

#: src/pynextcloud_sync/ui/about_content.py:78
msgid "Version 0.1.27"
msgstr "Versão 0.1.27"

#: src/pynextcloud_sync/ui/about_content.py:80
msgid ""
"Added a dedicated Account settings page with account, authorization, local "
"folder, quota, and server information."
msgstr ""
"Adicionada uma página Conta nas configurações com informações da conta, "
"autorização, pasta local, cota e servidor."

#: src/pynextcloud_sync/ui/about_content.py:81
msgid ""
"New browser authorizations use a stable per-computer name without the "
"application version."
msgstr ""
"Novas autorizações pelo navegador usam um nome estável por computador, sem a "
"versão do aplicativo."

#: src/pynextcloud_sync/ui/about_content.py:82
msgid ""
"Revoked authorizations can be renewed without resetting the local folder, "
"synchronization preferences, or safety baseline."
msgstr ""
"Autorizações revogadas podem ser renovadas sem reiniciar a pasta local, as "
"preferências de sincronização ou a base de segurança."

#: src/pynextcloud_sync/ui/about_content.py:83
msgid ""
"Authentication rejection remains blocked until the account is explicitly "
"reconnected."
msgstr ""
"Uma autenticação rejeitada permanece bloqueada até que a conta seja "
"reconectada explicitamente."

#: src/pynextcloud_sync/ui/about_content.py:87
msgid "Version 0.1.26"
msgstr "Versão 0.1.26"

#: src/pynextcloud_sync/ui/about_content.py:89
msgid ""
"Credential lookup no longer preloads every Secret Service collection item."
msgstr ""
"A busca da credencial não pré-carrega mais todos os itens da coleção do "
"Secret Service."

#: src/pynextcloud_sync/ui/about_content.py:90
msgid ""
"Credentials are located by an exact D-Bus search including server, username, "
"and schema."
msgstr ""
"As credenciais são localizadas por uma busca D-Bus exata que inclui "
"servidor, usuário e schema."

#: src/pynextcloud_sync/ui/about_content.py:91
msgid ""
"Matching paths are loaded individually so an orphaned legacy item cannot "
"block a valid credential."
msgstr ""
"Os caminhos correspondentes são carregados individualmente para que um item "
"legado órfão não bloqueie uma credencial válida."

#: src/pynextcloud_sync/ui/about_content.py:95
msgid "Version 0.1.25"
msgstr "Versão 0.1.25"

#: src/pynextcloud_sync/ui/about_content.py:97
msgid ""
"Fixed false credential verification failures caused by a cached pre-write "
"Secret Service view."
msgstr ""
"Corrigidas falsas falhas de verificação da credencial causadas por uma visão "
"anterior à gravação mantida em cache pelo Secret Service."

#: src/pynextcloud_sync/ui/about_content.py:98
msgid ""
"Successful keyring writes are now verified through a fresh Secret Service "
"connection."
msgstr ""
"Gravações bem-sucedidas na carteira agora são verificadas por uma nova "
"conexão com o Secret Service."

#: src/pynextcloud_sync/ui/about_content.py:99
msgid ""
"Setup remains blocked if the exact stored credential still cannot be read "
"back."
msgstr ""
"A configuração permanece bloqueada se a credencial exata armazenada ainda "
"não puder ser relida."

#: src/pynextcloud_sync/ui/about_content.py:103
msgid "Version 0.1.24"
msgstr "Versão 0.1.24"

#: src/pynextcloud_sync/ui/about_content.py:105
msgid ""
"Fixed the dead-end safety-analysis screen shown when no stored account "
"credential exists."
msgstr ""
"Corrigida a tela sem saída da análise de segurança exibida quando não existe "
"uma credencial armazenada da conta."

#: src/pynextcloud_sync/ui/about_content.py:106
msgid ""
"Authentication failures now offer Reconnect Account instead of repeating an "
"impossible credential lookup."
msgstr ""
"Falhas de autenticação agora oferecem Conectar conta novamente em vez de "
"repetir uma busca impossível da credencial."

#: src/pynextcloud_sync/ui/about_content.py:107
msgid ""
"Returning to account login preserves the selected local folder and every "
"file inside it."
msgstr ""
"Voltar ao login da conta preserva a pasta local selecionada e todos os "
"arquivos dentro dela."

#: src/pynextcloud_sync/ui/about_content.py:111
msgid "Version 0.1.23"
msgstr "Versão 0.1.23"

#: src/pynextcloud_sync/ui/about_content.py:113
msgid ""
"New credentials use a versioned Secret Service schema so an orphaned legacy "
"item cannot intercept replacement writes."
msgstr ""
"Novas credenciais usam um schema versionado do Secret Service para que um "
"item legado órfão não intercepte gravações de substituição."

#: src/pynextcloud_sync/ui/about_content.py:114
msgid ""
"Healthy legacy credentials remain readable and both schema versions are "
"cleared when an account is removed."
msgstr ""
"Credenciais legadas saudáveis continuam legíveis e as duas versões do schema "
"são limpas quando uma conta é removida."

#: src/pynextcloud_sync/ui/about_content.py:115
msgid ""
"Every successful keyring write is verified by reading the credential back "
"before setup continues."
msgstr ""
"Toda gravação bem-sucedida na carteira é verificada relendo a credencial "
"antes de a configuração continuar."

#: src/pynextcloud_sync/ui/about_content.py:119
msgid "Version 0.1.22"
msgstr "Versão 0.1.22"

#: src/pynextcloud_sync/ui/about_content.py:121
msgid ""
"Matching GNOME Keyring items are now loaded individually so an orphaned D-"
"Bus path cannot hide a valid credential."
msgstr ""
"Os itens correspondentes do GNOME Keyring agora são carregados "
"individualmente para que um caminho D-Bus órfão não oculte uma credencial "
"válida."

#: src/pynextcloud_sync/ui/about_content.py:122
msgid ""
"Credential search now checks every matching item and skips stale entries "
"safely."
msgstr ""
"A busca da credencial agora verifica todos os itens correspondentes e ignora "
"entradas obsoletas com segurança."

#: src/pynextcloud_sync/ui/about_content.py:123
msgid ""
"If no valid credential remains, the application requests authentication "
"instead of repeatedly exposing an internal D-Bus error."
msgstr ""
"Se nenhuma credencial válida restar, o aplicativo solicita autenticação em "
"vez de exibir repetidamente um erro interno do D-Bus."

#: src/pynextcloud_sync/ui/about_content.py:127
msgid "Version 0.1.21"
msgstr "Versão 0.1.21"

#: src/pynextcloud_sync/ui/about_content.py:129
msgid ""
"Fixed repeated credential failures caused by stale GNOME Keyring D-Bus item "
"paths."
msgstr ""
"Corrigidas falhas repetidas de credenciais causadas por caminhos D-Bus "
"obsoletos de itens do GNOME Keyring."

#: src/pynextcloud_sync/ui/about_content.py:130
msgid ""
"Credential lookup now reconnects to Secret Service and retries once when the "
"referenced item no longer exists."
msgstr ""
"A busca da credencial agora se reconecta ao Secret Service e repete uma vez "
"quando o item referenciado não existe mais."

#: src/pynextcloud_sync/ui/about_content.py:131
msgid ""
"The recovery is bounded to one retry and preserves unrelated keyring error "
"reporting."
msgstr ""
"A recuperação é limitada a uma repetição e preserva o relato de erros não "
"relacionados da carteira."

#: src/pynextcloud_sync/ui/about_content.py:135
msgid "Version 0.1.20"
msgstr "Versão 0.1.20"

#: src/pynextcloud_sync/ui/about_content.py:137
msgid ""
"Fixed the false locked-keyring state after a successful native GNOME Keyring "
"unlock prompt."
msgstr ""
"Corrigido o falso estado de carteira bloqueada após uma solicitação nativa "
"de desbloqueio do GNOME Keyring concluída com sucesso."

#: src/pynextcloud_sync/ui/about_content.py:138
msgid ""
"Credential lookup now verifies the unlock by loading the stored secret "
"instead of trusting a potentially stale D-Bus property."
msgstr ""
"A busca da credencial agora confirma o desbloqueio carregando o segredo "
"armazenado, em vez de confiar em uma propriedade D-Bus possivelmente "
"desatualizada."

#: src/pynextcloud_sync/ui/about_content.py:139
msgid ""
"Added compatibility and regression coverage for PyGObject unlock return "
"variants while preserving canceled-prompt behavior."
msgstr ""
"Adicionadas compatibilidade e cobertura de regressão para variantes de "
"retorno de desbloqueio do PyGObject, preservando o comportamento da "
"solicitação cancelada."

#: src/pynextcloud_sync/ui/about_content.py:143
msgid "Version 0.1.19"
msgstr "Versão 0.1.19"

#: src/pynextcloud_sync/ui/about_content.py:145
msgid ""
"Relicensed PyNextCloud Sync under the GNU General Public License version 3 "
"or later."
msgstr ""
"O PyNextCloud Sync foi relicenciado sob a Licença Pública Geral GNU versão 3 "
"ou posterior."

#: src/pynextcloud_sync/ui/about_content.py:146
msgid ""
"About now identifies and displays the GPLv3 license using GTK's native "
"license presentation."
msgstr ""
"A tela Sobre agora identifica e exibe a licença GPLv3 usando a apresentação "
"nativa de licenças do GTK."

#: src/pynextcloud_sync/ui/about_content.py:147
msgid ""
"Updated project, Debian, AppStream, documentation, terms, and translation "
"metadata to consistently identify the new license."
msgstr ""
"Atualizados os metadados do projeto, Debian, AppStream, documentação, termos "
"e traduções para identificar de forma consistente a nova licença."

#: src/pynextcloud_sync/ui/about_content.py:151
msgid "Version 0.1.18"
msgstr "Versão 0.1.18"

#: src/pynextcloud_sync/ui/about_content.py:153
msgid ""
"Recovered explicitly from Linux inotify queue overflow by rebuilding "
"filesystem monitoring and requesting a protected nextcloudcmd reconciliation."
msgstr ""
"Recuperação explícita do estouro da fila do inotify no Linux, reconstruindo "
"o monitoramento do sistema de arquivos e solicitando uma reconciliação "
"protegida pelo nextcloudcmd."

#: src/pynextcloud_sync/ui/about_content.py:154
msgid ""
"Added a durable marker around nextcloudcmd that is cleared only after a "
"successful safety baseline commit."
msgstr ""
"Adicionado um marcador durável em torno do nextcloudcmd, removido somente "
"após a gravação bem-sucedida de uma nova base de segurança."

#: src/pynextcloud_sync/ui/about_content.py:155
msgid ""
"Retained the previous last-known-good safety baseline after interrupted runs."
msgstr ""
"Mantida a última base de segurança válida após execuções interrompidas."

#: src/pynextcloud_sync/ui/about_content.py:159
msgid "Version 0.1.17"
msgstr "Versão 0.1.17"

#: src/pynextcloud_sync/ui/about_content.py:161
msgid ""
"Automatic update notices now wait until the main window is fully mapped "
"before they are created."
msgstr ""
"Os avisos automáticos de atualização agora aguardam até que a janela "
"principal esteja completamente mapeada antes de serem criados."

#: src/pynextcloud_sync/ui/about_content.py:162
msgid ""
"Update windows are no longer reassociated after becoming visible, preventing "
"placement on another monitor at the desktop origin."
msgstr ""
"As janelas de atualização não são mais reassociadas após ficarem visíveis, "
"evitando que sejam posicionadas em outro monitor na origem da área de "
"trabalho."

#: src/pynextcloud_sync/ui/about_content.py:163
msgid ""
"Mandatory updates now show only Download New Version and Close Application."
msgstr ""
"Atualizações obrigatórias agora exibem somente Baixar nova versão e Fechar "
"aplicativo."

#: src/pynextcloud_sync/ui/about_content.py:167
msgid "Version 0.1.16"
msgstr "Versão 0.1.16"

#: src/pynextcloud_sync/ui/about_content.py:169
msgid ""
"The update notice now remains above the main window when the application is "
"opened from its launcher."
msgstr ""
"O aviso de atualização agora permanece acima da janela principal quando o "
"aplicativo é aberto pelo atalho."

#: src/pynextcloud_sync/ui/about_content.py:170
msgid ""
"Download and dismissal actions remain visible above the scrollable release "
"details."
msgstr ""
"As ações para baixar e dispensar permanecem visíveis acima dos detalhes "
"roláveis da release."

#: src/pynextcloud_sync/ui/about_content.py:171
msgid "Download New Version now opens the latest GitHub release directly."
msgstr ""
"Baixar nova versão agora abre diretamente a release mais recente no GitHub."

#: src/pynextcloud_sync/ui/about_content.py:172
msgid ""
"Mandatory updates use an urgent warning presentation and keep Not Now "
"disabled."
msgstr ""
"Atualizações obrigatórias usam um aviso urgente e mantêm Agora não "
"desativado."

#: src/pynextcloud_sync/ui/about_content.py:176
msgid "Version 0.1.15"
msgstr "Versão 0.1.15"

#: src/pynextcloud_sync/ui/about_content.py:178
msgid ""
"Added automatic startup update checks through a validated GitHub version "
"manifest."
msgstr ""
"Foram adicionadas verificações automáticas de atualização na inicialização "
"por meio de um manifesto de versão validado no GitHub."

#: src/pynextcloud_sync/ui/about_content.py:179
msgid ""
"Optional updates remain non-blocking, while mandatory updates prevent the "
"synchronization runtime from starting."
msgstr ""
"As atualizações opcionais não bloqueiam o uso, enquanto as obrigatórias "
"impedem a inicialização do mecanismo de sincronização."

#: src/pynextcloud_sync/ui/about_content.py:180
msgid ""
"Added a manual update check in About, semantic version comparison, safe "
"failure handling, and UTC release dates."
msgstr ""
"Foi adicionada a verificação manual de atualização em Sobre, comparação "
"semântica de versões, tratamento seguro de falhas e datas de lançamento em "
"UTC."

#: src/pynextcloud_sync/ui/about_content.py:181
msgid ""
"The update window now shows a short summary and an expandable full changelog."
msgstr ""
"A janela de atualização agora mostra um resumo curto e um histórico completo "
"de alterações expansível."

#: src/pynextcloud_sync/ui/about_content.py:185
msgid "Version 0.1.14"
msgstr "Versão 0.1.14"

#: src/pynextcloud_sync/ui/about_content.py:187
msgid ""
"Added a protected first synchronization with a fresh isolated server "
"snapshot and an explicit merge review."
msgstr ""
"Adicionada uma primeira sincronização protegida, com uma cópia nova e "
"isolada do servidor e uma revisão explícita da mesclagem."

#: src/pynextcloud_sync/ui/about_content.py:188
msgid ""
"Existing synchronization databases are archived and never silently reused "
"during initialization."
msgstr ""
"Bancos de sincronização existentes são arquivados e nunca são reutilizados "
"silenciosamente durante a inicialização."

#: src/pynextcloud_sync/ui/about_content.py:189
msgid ""
"Added a persistent safety baseline that blocks missing, replaced, empty, "
"unreadable, or abnormally reduced local folders before nextcloudcmd starts."
msgstr ""
"Adicionada uma base de segurança persistente que bloqueia pastas locais "
"ausentes, substituídas, vazias, ilegíveis ou reduzidas de forma anormal "
"antes de iniciar o nextcloudcmd."

#: src/pynextcloud_sync/ui/about_content.py:190
msgid ""
"Added safe recovery, one-time deletion approval, preserved conflict copies, "
"and configurable review thresholds."
msgstr ""
"Adicionadas recuperação segura, aprovação única de exclusões, cópias "
"preservadas de conflitos e limites de revisão configuráveis."

#: src/pynextcloud_sync/ui/about_content.py:194
msgid "Version 0.1.13"
msgstr "Versão 0.1.13"

#: src/pynextcloud_sync/ui/about_content.py:196
msgid ""
"The default GNOME password collection is now unlocked before searching for "
"the Nextcloud credential after biometric login."
msgstr ""
"A coleção de senhas padrão do GNOME agora é desbloqueada antes da busca pela "
"credencial do Nextcloud após o login biométrico."

#: src/pynextcloud_sync/ui/about_content.py:197
msgid ""
"A locked Login collection is no longer misreported as a missing stored "
"credential during desktop autostart."
msgstr ""
"Uma coleção Login bloqueada não é mais informada incorretamente como uma "
"credencial armazenada ausente durante a inicialização automática do ambiente "
"gráfico."

#: src/pynextcloud_sync/ui/about_content.py:198
msgid ""
"Added diagnostic logging and a regression test for credentials hidden while "
"the keyring is locked."
msgstr ""
"Adicionados registros de diagnóstico e um teste de regressão para "
"credenciais ocultas enquanto a carteira está bloqueada."

#: src/pynextcloud_sync/ui/about_content.py:202
msgid "Version 0.1.12"
msgstr "Versão 0.1.12"

#: src/pynextcloud_sync/ui/about_content.py:204
msgid ""
"Fixed Debian upgrade detection by querying the live D-Bus owner instead of "
"treating list-apps as a process list."
msgstr ""
"Corrigida a detecção de atualizações Debian consultando o proprietário D-Bus "
"ativo, em vez de tratar list-apps como uma lista de processos."

#: src/pynextcloud_sync/ui/about_content.py:205
msgid ""
"The package now confirms that the old instance has exited before replacing "
"application files."
msgstr ""
"Agora o pacote confirma que a instância antiga foi encerrada antes de "
"substituir os arquivos do aplicativo."

#: src/pynextcloud_sync/ui/about_content.py:206
msgid ""
"Replaced the inaccurate package-upgrade fixture with a regression test that "
"matches the real GLib behavior."
msgstr ""
"Substituído o cenário de teste impreciso da atualização do pacote por um "
"teste de regressão que corresponde ao comportamento real do GLib."

#: src/pynextcloud_sync/ui/about_content.py:210
msgid "Version 0.1.11"
msgstr "Versão 0.1.11"

#: src/pynextcloud_sync/ui/about_content.py:212
msgid ""
"Fixed detection of running application instances during Debian upgrades when "
"APT/dpkg does not preserve SUDO_UID."
msgstr ""
"Corrigida a detecção de instâncias em execução durante atualizações Debian "
"quando o APT/dpkg não preserva SUDO_UID."

#: src/pynextcloud_sync/ui/about_content.py:213
msgid ""
"Upgrades now stop and restart the application through its real per-user D-"
"Bus session."
msgstr ""
"As atualizações agora encerram e reiniciam o aplicativo por sua sessão D-Bus "
"real de usuário."

#: src/pynextcloud_sync/ui/about_content.py:214
msgid ""
"Added an executable regression test for graceful package-upgrade shutdown "
"and restart."
msgstr ""
"Adicionado um teste executável de regressão para o encerramento e a "
"reinicialização seguros durante a atualização do pacote."

#: src/pynextcloud_sync/ui/about_content.py:218
msgid "Version 0.1.10"
msgstr "Versão 0.1.10"

#: src/pynextcloud_sync/ui/about_content.py:220
msgid ""
"Added the native GNOME Keyring unlock prompt required after biometric "
"desktop login."
msgstr ""
"Adicionada a solicitação nativa de desbloqueio do GNOME Keyring, necessária "
"após o login biométrico no ambiente de trabalho."

#: src/pynextcloud_sync/ui/about_content.py:221
msgid ""
"Canceled unlocks now remain separate from invalid Nextcloud credentials "
"without repeated automatic prompts."
msgstr ""
"O cancelamento do desbloqueio agora permanece separado de credenciais "
"inválidas do Nextcloud, sem solicitações automáticas repetidas."

#: src/pynextcloud_sync/ui/about_content.py:222
msgid ""
"File synchronization and notify_push resume together after the keyring is "
"unlocked."
msgstr ""
"A sincronização de arquivos e o notify_push são retomados juntos após o "
"desbloqueio da carteira."

#: src/pynextcloud_sync/ui/about_content.py:223
msgid ""
"Interactive Debian upgrades now gracefully stop and restart a running "
"application."
msgstr ""
"As atualizações interativas pelo Debian agora encerram com segurança e "
"reiniciam o aplicativo quando ele está em execução."

#: src/pynextcloud_sync/ui/about_content.py:227
msgid "Version 0.1.9"
msgstr "Versão 0.1.9"

#: src/pynextcloud_sync/ui/about_content.py:229
msgid ""
"Published the corrected website, source, issue, and changelog links under "
"the canonical repository."
msgstr ""
"Publicados os links corrigidos do site, código-fonte, problemas e histórico "
"de alterações no repositório canônico."

#: src/pynextcloud_sync/ui/about_content.py:233
msgid "Version 0.1.8"
msgstr "Versão 0.1.8"

#: src/pynextcloud_sync/ui/about_content.py:235
msgid ""
"Added native Files sidebar and desktop shortcuts for the synchronized folder."
msgstr ""
"Adicionados atalhos nativos para a pasta sincronizada na lateral do Arquivos "
"e na Área de Trabalho."

#: src/pynextcloud_sync/ui/about_content.py:236
msgid ""
"Added a branded folder icon and settings for all three desktop integrations."
msgstr ""
"Adicionados um ícone próprio para a pasta e configurações para as três "
"integrações com o ambiente."

#: src/pynextcloud_sync/ui/about_content.py:237
msgid ""
"Removing the Files bookmark outside the application now updates Settings "
"without recreating it."
msgstr ""
"Remover o favorito pelo Arquivos agora atualiza as Configurações sem recriá-"
"lo."

#: src/pynextcloud_sync/ui/about_content.py:241
msgid "Version 0.1.7"
msgstr "Versão 0.1.7"

#: src/pynextcloud_sync/ui/about_content.py:243
msgid ""
"Settings now opens independently from the tray without opening the main "
"window."
msgstr ""
"As Configurações agora abrem de forma independente pela bandeja, sem abrir a "
"janela principal."

#: src/pynextcloud_sync/ui/about_content.py:244
msgid ""
"The independent Settings window is released after closing to preserve the "
"low-memory interface lifecycle."
msgstr ""
"A janela independente de Configurações é liberada após o fechamento para "
"preservar o ciclo de vida da interface com baixo consumo de memória."

#: src/pynextcloud_sync/ui/about_content.py:248
msgid "Version 0.1.6"
msgstr "Versão 0.1.6"

#: src/pynextcloud_sync/ui/about_content.py:250
msgid "Fixed opening Settings from the tray while the main window is closed."
msgstr ""
"Corrigida a abertura das Configurações pela bandeja quando a janela "
"principal está fechada."

#: src/pynextcloud_sync/ui/about_content.py:251
msgid ""
"Reduced background memory by creating the main interface only when needed "
"and releasing it when closed."
msgstr ""
"O consumo de memória em segundo plano foi reduzido criando a interface "
"principal somente quando necessária e liberando-a ao fechar."

#: src/pynextcloud_sync/ui/about_content.py:252
msgid ""
"Bounded command output, log display, activity history, and browser login "
"polling."
msgstr ""
"A saída do comando, a exibição do log, o histórico de atividades e a "
"consulta do login pelo navegador agora têm limites definidos."

#: src/pynextcloud_sync/ui/about_content.py:253
msgid ""
"Avoided unnecessary filesystem watcher and push connection reconfiguration."
msgstr ""
"Evitada a reconfiguração desnecessária do monitor de arquivos e da conexão "
"push."

#: src/pynextcloud_sync/ui/about_content.py:257
msgid "Version 0.1.5"
msgstr "Versão 0.1.5"

#: src/pynextcloud_sync/ui/about_content.py:259
msgid ""
"Activity messages can now be expanded with one click and copied from a right-"
"click menu."
msgstr ""
"As mensagens de atividade agora podem ser expandidas com um clique e "
"copiadas pelo menu do botão direito."

#: src/pynextcloud_sync/ui/about_content.py:260
msgid ""
"Fixed Brazilian Portuguese loading and completed the application translation "
"catalog."
msgstr ""
"Corrigido o carregamento do português do Brasil e concluído o catálogo de "
"tradução do aplicativo."

#: src/pynextcloud_sync/ui/about_content.py:264
msgid "Version 0.1.4"
msgstr "Versão 0.1.4"

#: src/pynextcloud_sync/ui/about_content.py:266
msgid ""
"Made the tray icon and details follow synchronization state changes live."
msgstr ""
"O ícone e os detalhes da bandeja agora acompanham ao vivo as mudanças no "
"estado da sincronização."

#: src/pynextcloud_sync/ui/about_content.py:267
msgid ""
"Added compatible StatusNotifierItem and D-Bus property change notifications."
msgstr ""
"Foram adicionadas notificações compatíveis de mudança de propriedades do "
"StatusNotifierItem e D-Bus."

#: src/pynextcloud_sync/ui/about_content.py:271
msgid "Version 0.1.3"
msgstr "Versão 0.1.3"

#: src/pynextcloud_sync/ui/about_content.py:273
msgid "Fixed the application icon displayed by GNOME tray hosts."
msgstr "Correção do ícone do aplicativo exibido pela bandeja do GNOME."

#: src/pynextcloud_sync/ui/about_content.py:274
msgid "Added icon theme, absolute SVG, and pixel fallback support."
msgstr ""
"Adicionado suporte a tema de ícones, SVG absoluto e fallback em pixels."

#: src/pynextcloud_sync/ui/about_content.py:278
msgid "Version 0.1.2"
msgstr "Versão 0.1.2"

#: src/pynextcloud_sync/ui/about_content.py:280
msgid "A more compact, responsive main window with a stable status header."
msgstr ""
"Uma janela principal mais compacta e responsiva, com cabeçalho de status "
"estável."

#: src/pynextcloud_sync/ui/about_content.py:281
msgid ""
"Collapsible recent activity with severity icons and single-line messages."
msgstr ""
"Atividade recente recolhível, com ícones de severidade e mensagens em uma "
"linha."

#: src/pynextcloud_sync/ui/about_content.py:282
msgid "A working one-click tray menu and more reliable window presentation."
msgstr ""
"Menu funcional na bandeja com um clique e apresentação mais confiável da "
"janela."

#: src/pynextcloud_sync/ui/about_content.py:283
msgid "Optional daily log files with configurable retention."
msgstr "Arquivos de log diários opcionais com retenção configurável."

#: src/pynextcloud_sync/ui/about_content.py:284
msgid ""
"Expanded About, legal terms, license, credits, and changelog information."
msgstr ""
"Sobre ampliado com termos, licença, créditos e histórico de alterações."

#: src/pynextcloud_sync/ui/about_content.py:285
msgid ""
"Fixed D-Bus menu variants, literal log rendering, and numeric log formatting."
msgstr ""
"Correções nas variantes do menu D-Bus, no texto literal e na formatação "
"numérica dos logs."

#: src/pynextcloud_sync/ui/about_content.py:289
msgid "Version 0.1.1"
msgstr "Versão 0.1.1"

#: src/pynextcloud_sync/ui/about_content.py:291
msgid ""
"Fixed GNOME Keyring compatibility for saving, reading, and removing "
"credentials."
msgstr ""
"Correção da compatibilidade com o GNOME Keyring ao salvar, ler e remover "
"credenciais."

#: src/pynextcloud_sync/ui/about_content.py:292
msgid "Moved Keyring operations away from the GTK main thread."
msgstr ""
"As operações da carteira foram movidas para fora da thread principal do GTK."

#: src/pynextcloud_sync/ui/about_content.py:296
msgid "Version 0.1.0"
msgstr "Versão 0.1.0"

#: src/pynextcloud_sync/ui/about_content.py:298
msgid ""
"Initial development release with browser login, nextcloudcmd "
"synchronization, inotify, timers, notify_push, exclusions, logs, and GNOME "
"integration."
msgstr ""
"Versão inicial de desenvolvimento com login pelo navegador, sincronização "
