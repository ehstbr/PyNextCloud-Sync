msgid "Checking the saved protected copy…"
msgstr "Comprobando la copia protegida guardada…"

#: src/pynextcloud_sync/core/bootstrap.py:415
#: src/pynextcloud_sync/core/bootstrap.py:613
msgid ""
"The saved protected copy has changed. Download a new copy before continuing."
msgstr ""
"La copia protegida guardada ha cambiado. Descarga una nueva copia para "
"continuar."

#: src/pynextcloud_sync/core/bootstrap.py:436
msgid "Inventorying the protected copy…"
msgstr "Inventariando la copia protegida…"

#: src/pynextcloud_sync/core/bootstrap.py:439
msgid "Some paths in the protected copy could not be read."
msgstr "No se pudieron leer algunas rutas de la copia protegida."

#: src/pynextcloud_sync/core/bootstrap.py:441
msgid "The protected copy has no synchronization journal."
msgstr "La copia protegida no tiene un registro de sincronización."

#: src/pynextcloud_sync/core/bootstrap.py:454
